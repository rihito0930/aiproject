seoul_map = folium.Map(
    location=[37.5665, 126.9780],
    zoom_start=12,
    tiles="OpenStreetMap"
)

# 1일 차 관광지
day1_coords = []

# 2일 차 관광지
day2_coords = []

# 관광지 마커 표시
for index, place in enumerate(places, start=1):

    if place["day"] == 1:
        color = "blue"
        day1_coords.append(
            [place["lat"], place["lon"]]
        )
    else:
        color = "red"
        day2_coords.append(
            [place["lat"], place["lon"]]
        )

    popup_text = f"""
    <div style="width:220px">
        <h4>{index}. {place['name']}</h4>
        <p><b>방문 날짜:</b> {place['day']}일 차</p>
        <p>{place['description']}</p>
        <p><b>추천 활동:</b> {place['activity']}</p>
    </div>
    """

    folium.Marker(
        location=[place["lat"], place["lon"]],
        popup=folium.Popup(
            popup_text,
            max_width=270
        ),
        tooltip=f"{index}. {place['name']}",
        icon=folium.Icon(
            color=color,
            icon="info-sign"
        )
    ).add_to(seoul_map)

# 1일 차 이동 순서 표시
folium.PolyLine(
    day1_coords,
    color="blue",
    weight=4,
    opacity=0.7,
    tooltip="1일 차 여행 코스"
).add_to(seoul_map)

# 2일 차 이동 순서 표시
